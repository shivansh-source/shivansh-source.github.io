---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

const contributions = [
  {
    project: "OpenEverest",
    title:
      "Fixed the Postgres provider to watch Instances across all namespaces",
    href: "https://github.com/openeverest/provider-percona-postgresql/pull/21",
  },
  {
    project: "KubeStellar",
    title:
      "Generalized E2E tests to run against released KubeFlex artifacts",
    href: "https://github.com/kubestellar/kubeflex/pull/594",
  },
  {
    project: "Open Cluster Management",
    title: "Added TLS profile configuration support for spoke cluster agents",
    href: "https://github.com/open-cluster-management-io/ocm/pull/1486",
  },
  {
    project: "kro",
    title:
      "KREP-008: design proposal for resource-backed includeWhen evaluation",
    href: "https://github.com/kubernetes-sigs/kro/pull/933",
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section
      id="hero"
      class="border-border flex items-start justify-between gap-4 border-b pt-6 pb-6"
    >
      <div>
        <p>
          Cloud-native engineer and CNCF contributor. Notes on infrastructure
          and AI systems.
        </p>
        {
          socials.length > 0 && (
            <div class="mt-3 flex max-sm:flex-col sm:items-center">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
            </div>
          )
        }
      </div>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="mt-1 inline-block shrink-0"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>
    </section>

    <section
      id="contributions"
      class="border-border border-b pt-8 pb-6"
    >
      <h2 class="text-2xl font-semibold tracking-wide">
        Recent contributions
      </h2>
      <ul>
        {contributions.map(c => (
          <li class="my-6">
            <a
              href={c.href}
              target="_blank"
              rel="noopener"
              class:list={[
                "text-accent inline-block text-lg font-medium",
                "decoration-dashed underline-offset-4 hover:underline",
                "focus-visible:no-underline focus-visible:underline-offset-0",
              ]}
            >
              {c.title}
            </a>
            <p class="text-muted-foreground text-sm">{c.project}</p>
          </li>
        ))}
      </ul>
      <LinkButton
        href={getRelativeLocaleUrl(locale, "about")}
        class="hover:text-accent underline decoration-dashed underline-offset-4"
      >
        See all contributions on the About page
      </LinkButton>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
