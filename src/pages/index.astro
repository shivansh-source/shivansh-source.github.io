---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HomeSidebar from "@/components/HomeSidebar.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { highlightedContributions } from "@/data/contributions";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

const projects = [
  {
    name: "GenSec",
    tagline: "Go · vulnerability scanning + LLM-driven remediation",
    href: "https://github.com/shivansh-source/gensec",
    description:
      "Scans Go repositories for vulnerabilities (Semgrep, Gitleaks, Trivy, plus a built-in pattern matcher), uses an LLM to triage findings in context, and opens a PR with a generated fix — for teams who want vulnerabilities remediated, not just listed. Early-stage and opinionated; a human still reviews and merges every PR.",
  },
];

const now = [
  {
    title: "Building GenSec — an LLM-assisted vulnerability scanner and patcher for Go",
    href: "https://github.com/shivansh-source/gensec",
  },
  {
    title: "OpenEverest: a curated LLM catalog for the KubeAI provider",
    href: "https://github.com/openeverest/provider-kubeai/pull/8",
  },
  {
    title:
      "OpenEverest: clickhouse-backup based backup/restore support for the ClickHouse provider",
    href: "https://github.com/openeverest/provider-altinity-clickhouse/pull/22",
  },
  {
    title: "OpenEverest: a couple of Helm chart fixes under review",
    href: "https://github.com/openeverest/helm-charts/pull/100",
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <div class="flex flex-col gap-8 pt-6 lg:flex-row lg:items-start lg:gap-12">
      <div class="min-w-0 flex-1">
        <section id="projects" class="border-border border-b pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Projects</h2>
          <ul>
            {projects.map(p => (
              <li class="my-6">
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener"
                  class:list={[
                    "text-accent inline-block text-lg font-medium",
                    "decoration-dashed underline-offset-4 hover:underline",
                    "focus-visible:no-underline focus-visible:underline-offset-0",
                  ]}
                >
                  {p.name}
                </a>
                <p class="text-muted-foreground text-sm">{p.tagline}</p>
                <p class="mt-1">{p.description}</p>
              </li>
            ))}
          </ul>
        </section>

        <section id="now" class="border-border border-b pt-8 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            Currently working on
          </h2>
          <ul class="mt-4 space-y-2">
            {now.map(n => (
              <li>
                <a
                  href={n.href}
                  target="_blank"
                  rel="noopener"
                  class="text-accent decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline"
                >
                  {n.title}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section
          id="contributions"
          class="border-border border-b pt-8 pb-6"
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            Recent contributions
          </h2>
          <ul>
            {highlightedContributions.map(c => (
              <li class="my-6">
                <a
                  href={c.href}
                  target="_blank"
                  rel="noopener"
                  class:list={[
                    "text-accent inline-block text-lg font-medium",
                    "decoration-dashed underline-offset-4 hover:underline",
                    "focus-visible:no-underline focus-visible:underline-offset-0",
                  ]}
                >
                  {c.title}
                </a>
                <p class="text-muted-foreground text-sm">{c.project}</p>
              </li>
            ))}
          </ul>
          <LinkButton
            href={getRelativeLocaleUrl(locale, "contributions")}
            class="hover:text-accent underline decoration-dashed underline-offset-4"
          >
            See all contributions
          </LinkButton>
        </section>

        {
          featuredPosts.length > 0 && (
            <section
              id="featured"
              class:list={[
                "pt-12 pb-6",
                { "border-border border-b": recentPosts.length > 0 },
              ]}
            >
              <h2 class="text-2xl font-semibold tracking-wide">
                {t.home.featured}
              </h2>
              <ul>
                {featuredPosts.map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </section>
          )
        }

        {
          recentPosts.length > 0 && (
            <section id="recent-posts" class="pt-12 pb-6">
              <h2 class="text-2xl font-semibold tracking-wide">
                {t.home.recentPosts}
              </h2>
              <ul>
                {recentPosts.slice(0, postsConfig.perIndex).map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </section>
          )
        }

        <div class="my-8 text-center">
          <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      </div>

      <HomeSidebar />
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
