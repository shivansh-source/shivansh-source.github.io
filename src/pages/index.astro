---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HomeSidebar from "@/components/HomeSidebar.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// One curated list, not two overlapping ones — mixes in-progress work with
// recent merged contributions, same format each time: repo, what, why.
const nowAndRecent = [
  {
    repo: "GenSec",
    what: "Building an LLM-assisted vulnerability scanner and patcher for Go",
    why: "closing the gap between finding a vulnerability and actually shipping the fix",
    href: "https://github.com/shivansh-source/gensec",
  },
  {
    repo: "OpenEverest",
    what: "Building a curated LLM catalog for the KubeAI provider",
    why: "so picking a supported model doesn't mean hand-writing an InstancePreset spec",
    href: "https://github.com/openeverest/provider-kubeai/pull/8",
  },
  {
    repo: "OpenEverest",
    what: "Fixed the Postgres provider to watch Instances across all namespaces",
    why: "instances outside the default namespace were silently never reconciled",
    href: "https://github.com/openeverest/provider-percona-postgresql/pull/21",
  },
  {
    repo: "KubeStellar",
    what: "Generalized E2E tests to run against released KubeFlex artifacts",
    why: "catches regressions in what users actually install, not just source builds",
    href: "https://github.com/kubestellar/kubeflex/pull/594",
  },
  {
    repo: "Open Cluster Management",
    what: "Added TLS profile configuration support for spoke cluster agents",
    why: "lets clusters meet stricter TLS compliance requirements",
    href: "https://github.com/open-cluster-management-io/ocm/pull/1486",
  },
  {
    repo: "kro",
    what: "KREP-008: design proposal for resource-backed includeWhen evaluation",
    why: "unblocks conditional resource composition other proposals were waiting on",
    href: "https://github.com/kubernetes-sigs/kro/pull/933",
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <div class="flex flex-col gap-8 pt-6 lg:flex-row lg:items-start lg:gap-12">
      <div class="min-w-0 flex-1">
        {
          // Posts lead the homepage — this site exists mainly for the blog.
          // Contributions/"now" are secondary, further down.
        }
        {
          featuredPosts.length > 0 && (
            <section
              id="featured"
              class="border-border first:pt-0 last:border-b-0 border-b pt-8 pb-6"
            >
              <h2 class="text-2xl font-semibold tracking-wide">
                {t.home.featured}
              </h2>
              <ul>
                {featuredPosts.map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </section>
          )
        }

        {
          recentPosts.length > 0 && (
            <section
              id="recent-posts"
              class="border-border first:pt-0 last:border-b-0 border-b pt-8 pb-6"
            >
              <h2 class="text-2xl font-semibold tracking-wide">
                {t.home.recentPosts}
              </h2>
              <ul>
                {recentPosts.slice(0, postsConfig.perIndex).map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </section>
          )
        }

        <section
          id="now"
          class="border-border first:pt-0 last:border-b-0 border-b pt-8 pb-6"
        >
          <h2 class="text-2xl font-semibold tracking-wide">Now</h2>
          <ul>
            {nowAndRecent.map(item => (
              <li class="my-6">
                <p class="text-muted-foreground text-sm">{item.repo}</p>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener"
                  class:list={[
                    "text-accent inline-block text-lg font-medium",
                    "decoration-dashed underline-offset-4 hover:underline",
                    "focus-visible:no-underline focus-visible:underline-offset-0",
                  ]}
                >
                  {item.what}
                </a>
                <p class="mt-1 text-sm italic">{item.why}</p>
              </li>
            ))}
          </ul>
          <LinkButton
            href={getRelativeLocaleUrl(locale, "contributions")}
            class="hover:text-accent underline decoration-dashed underline-offset-4"
          >
            See all contributions
          </LinkButton>
        </section>

        <div class="my-8 text-center">
          <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      </div>

      <HomeSidebar />
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
