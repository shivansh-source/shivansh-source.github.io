---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { contributionProjects } from "@/data/contributions";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "short",
});
---

<Layout title={`${t.pages.contributionsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={t.pages.contributionsTitle}
    pageDesc={t.pages.contributionsDesc}
  >
    {
      contributionProjects.map(project => (
        <section class="border-border border-b pt-6 pb-6 last:border-b-0">
          <h2 class="text-xl font-semibold">
            <a
              href={project.href}
              target="_blank"
              rel="noopener"
              class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              {project.name}
            </a>
          </h2>
          <p class="text-muted-foreground mt-1 text-sm">
            {project.description}
          </p>
          <ul class="mt-4">
            {project.items.map(item => (
              <li class="my-3 flex flex-col sm:flex-row sm:items-baseline sm:gap-2">
                <span class="text-muted-foreground shrink-0 text-sm">
                  {dateFormatter.format(new Date(item.mergedAt))}
                </span>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener"
                  class="text-accent decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline"
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <p class="text-muted-foreground mt-6 text-sm">
      Also filed a large batch of detailed bug reports from a systematic
      review of the KubeStellar Console dashboard, beyond the merged work
      listed above.
    </p>
  </Main>

  <Footer />
</Layout>
