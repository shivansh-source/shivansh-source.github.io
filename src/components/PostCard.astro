---
import type { CollectionEntry } from "astro:content";
import { getPostUrl, getPostOgImageUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";

type Props = CollectionEntry<"posts">;

const post = Astro.props;
const { id, data, filePath } = post;
const { title, description, tags, ...props } = data;

const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
const ogImage = getPostOgImageUrl(post, Astro.url.origin, Astro.currentLocale);
---

<li class="border-border flex flex-col gap-5 border-b py-6 first:pt-0 last:border-b-0 sm:flex-row">
  {
    ogImage && (
      <a href={postUrl} class="shrink-0" tabindex="-1" aria-hidden="true">
        <img
          src={ogImage}
          alt=""
          width={240}
          height={126}
          class="border-border w-full rounded-lg border object-cover sm:w-60"
        />
      </a>
    )
  }
  <div class="min-w-0 flex-1">
    <a
      href={postUrl}
      class:list={[
        "text-accent inline-block text-lg font-medium",
        "decoration-dashed underline-offset-4 hover:underline",
        "focus-visible:no-underline focus-visible:underline-offset-0",
      ]}
    >
      <h2 transition:name={toTransitionName(id)}>{title}</h2>
    </a>
    <Datetime {...props} />
    <p class="mt-1">{description}</p>
    {
      tags.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
          {tags.map(tag => (
            <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
          ))}
        </ul>
      )
    }
  </div>
</li>
